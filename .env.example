# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local Node (a locally reachable PostgreSQL instance):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/fairway_live?schema=public"
#
# Full Docker stack (set automatically by docker-compose for the app service):
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db:5432/fairway_live?schema=public"

DATABASE_URL="postgresql://postgres:change-this-local-password@localhost:5432/fairway_live?schema=public"
POSTGRES_PASSWORD=change-this-local-password

# -----------------------------------------------------------------------------
# GolfCourseAPI (optional — course search/import)
# -----------------------------------------------------------------------------
GOLF_COURSE_API_KEY=

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://your-domain.example
# Set both values for a local app on an alternate host port.
# FAIRWAY_HOST_PORT=3001
# NEXT_PUBLIC_APP_URL=http://localhost:3001

# Set to false on an internet-facing deployment that requires email-only host access.
ALLOW_GUEST_HOSTS=true
